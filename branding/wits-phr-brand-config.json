  "typography": {
    "primaryFonts": [
      {
        "name": "Inter",
        "weights": [400, 500, 600, 700],
        "usage": "Body text, data labels, captions",
        "url": "https://fonts.google.com/specimen/Inter",
        "import": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      },
      {
        "name": "Roboto",
        "weights": [400, 500, 700],
        "usage": "Headers, subheaders, emphasis",
        "url": "https://fonts.google.com/specimen/Roboto",
        "import": "https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      }
    ],
    "fallbackFonts": ["Arial", "Helvetica", "sans-serif"],
    "sizeHierarchy": {
      "slide_1920x1080": {
        "title": "80-120px",
        "subtitle": "48-64px",
        "sectionHeader": "56-72px",
        "bodyText": "32-40px",
        "captions": "24-28px",
        "labels": "28-32px"
      }
    },
    "lineHeight": {
      "titles": "1.1-1.2",
      "body": "1.4-1.6",
      "captions": "1.3-1.5"
    },
    "letterSpacing": {
      "titles": "-0.02em",
      "body": "0",
      "captions": "0.01em"
    }
  },
  "layout": {
    "slideFormat": {
      "standard": {
        "width": 1920,
        "height": 1080,
        "aspectRatio": "16:9"
      }
    },
    "margins": {
      "safe": {
        "all": "80-100px",
        "description": "Content safety margins from all edges"
      }
    },
    "grid": {
      "columns": [12, 24],
      "gutters": "40-60px"
    },
    "whitespace": {
      "target": "40-60%",
      "principle": "Embrace generous whitespace, never crowd content"
    }
  },
  "logo": {
    "placement": {
      "preferred": ["bottom-right", "top-right"],
      "margins": "40-60px from edges"
    },
    "sizing": {
      "width": "120-180px",
      "maintainAspectRatio": true
    },
    "variants": {
      "dark": {
        "filename": "logo-dark.png",
        "usage": "Light backgrounds"
      },
      "light": {
        "filename": "logo-light-bordered.png",
        "usage": "Dark backgrounds"
      }
    }
  },
  "accessibility": {
    "colorContrast": {
      "standard": "WCAG AA minimum",
      "textOnBackground": {
        "darkOnLight": {
          "text": "#1a1a1a",
          "background": "#ffffff",
          "ratio": "16.5:1"
        },
        "lightOnDark": {
          "text": "#ffffff",
          "background": "#1a1a1a",
          "ratio": "16.5:1"
        }
      }
    },
    "dataVisualization": {
      "colorBlindSafe": true,
      "patternFills": "Use as alternative to color",
      "directLabeling": "Prefer over legend-only"
    }
  },
  "designPrinciples": [
    "Clarity over decoration",
    "Data-driven storytelling",
    "Professional and accessible",
    "Scientific rigor with visual appeal",
    "Consistent brand presence",
    "Figma-editable by default"
  ]
}
